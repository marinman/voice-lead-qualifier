# --- LiveKit (required for voice) -------------------------------------------
# From your LiveKit Cloud project: Settings -> Keys. Free tier works.
# Leave blank and the app still boots: text chat + reviewer mode keep working.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# inference (default) | openai  (openai = OpenAI plugins + OPENAI_API_KEY, for self-hosted)
AGENT_PROVIDER=inference

# --- Agent models (LiveKit Inference, billed through your LiveKit project) ----
# No separate STT/LLM/TTS keys needed. Override to try other providers.
AGENT_STT=deepgram/nova-3:en
AGENT_LLM=openai/gpt-4.1-mini
AGENT_TTS=cartesia/sonic-3:9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
AGENT_NAME=lead-qualifier
SILENCE_SECONDS=10

# --- Post-call extraction ------------------------------------------------------
# With OPENAI_API_KEY set, an LLM turns transcripts into fields (JSON schema).
# Without it, a deterministic keyword extractor runs instead.
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
# auto | llm | rules
EXTRACTION_MODE=auto
